# Arogya Mitra Backend — Environment Variables
# Copy to .env and fill in values

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./arogya_mitra.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arogya_mitra

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development
APP_TITLE=Arogya Mitra API
DEFAULT_BRANCH_ID=

# Redis (Phase 2+)
# REDIS_URL=redis://localhost:6379/0

# MinIO / S3 (Phase 3+)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
